<section class="ddbi-display-region-config-body">
  <div class="ddbi-display-region-preview-row">
    <div class="ddbi-display-region-preview-frame large" data-tooltip="{{localize 'ddb-importer.behaviors.display.preview.large'}}">
      <div class="ddbi-display-region-preview" data-grid="{{previewGridLarge}}" style="{{previewStyleLarge}}" data-image-preview="{{previewImageLarge}}"><span class="ddbi-display-region-fill"></span></div>
    </div>
    <div class="ddbi-display-region-preview-frame" data-tooltip="{{localize 'ddb-importer.behaviors.display.preview.small'}}">
      <div class="ddbi-display-region-preview" data-grid="{{previewGrid}}" style="{{previewStyle}}" data-image-preview="{{previewImage}}"><span class="ddbi-display-region-fill"></span></div>
    </div>
  </div>
  <p class="hint ddbi-display-region-summary-text">{{summary}}</p>

  <div class="form-group">
    <label>{{localize "ddb-importer.behaviors.display.config.profile"}}</label>
    <div class="form-fields">
      <div class="ddbi-display-region-picker">
        <select name="profile">
          {{#each profileGroups}}
          {{#if label}}<optgroup label="{{label}}">{{/if}}
          {{#each options}}
          <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
          {{/each}}
          {{#if label}}</optgroup>{{/if}}
          {{/each}}
        </select>
        {{#if canEditProfiles}}
        <button type="button" class="ddbi-display-region-picker-edit" data-tooltip="{{localize 'ddb-importer.behaviors.display.editProfiles'}}" aria-label="{{localize 'ddb-importer.behaviors.display.editProfiles'}}">
          <i class="fa-solid fa-gears" inert></i>
        </button>
        {{/if}}
      </div>
    </div>
    <p class="hint">{{localize "ddb-importer.behaviors.display.config.hint"}}</p>
  </div>

  {{#if hasProfile}}
  <div class="form-group">
    <label>{{localize "ddb-importer.behaviors.display.FIELDS.pattern.label"}}</label>
    <div class="form-fields">
      <select name="pattern">
        {{#each patternOptions}}
        <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
        {{/each}}
      </select>
    </div>
    <p class="hint">{{localize "ddb-importer.behaviors.display.FIELDS.pattern.hint"}}</p>
  </div>

  {{> "modules/ddb-importer/handlebars/region-display/image-fields.hbs"}}

  {{#if showDashed}}
  <div class="form-group">
    <label>{{localize "ddb-importer.behaviors.display.FIELDS.dashed.label"}}</label>
    <div class="form-fields">
      <select name="dashed">
        {{#each dashedOptions}}
        <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
        {{/each}}
      </select>
    </div>
    <p class="hint">{{localize "ddb-importer.behaviors.display.FIELDS.dashed.hint"}}</p>
  </div>
  {{/if}}

  {{#if showBorder}}
  <div class="form-group">
    <label>{{localize "ddb-importer.behaviors.display.FIELDS.border.label"}}</label>
    <div class="form-fields">
      <select name="border">
        {{#each borderOptions}}
        <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
        {{/each}}
      </select>
    </div>
    <p class="hint">{{localize "ddb-importer.behaviors.display.FIELDS.border.hint"}}</p>
  </div>
  {{/if}}

  {{#if showPerSquare}}
  <div class="form-group">
    <label>{{localize "ddb-importer.behaviors.display.perSquare.label"}}</label>
    <div class="form-fields">
      <input type="number" name="perSquare" value="{{perSquare}}" min="1" max="20" step="1" placeholder="{{perSquarePlaceholder}}" />
    </div>
    <p class="hint">{{localize "ddb-importer.behaviors.display.perSquare.regionHint"}}</p>
  </div>
  {{/if}}

  <div class="ddbi-display-region-config-grid">
    {{#each numericFields}}
    <div class="form-group">
      <label>{{label}}</label>
      <div class="form-fields">
        <input type="number" name="{{key}}" value="{{value}}" placeholder="{{placeholder}}" min="{{limits.min}}" max="{{limits.max}}" step="{{limits.step}}" />
      </div>
      <p class="hint">{{hint}}</p>
    </div>
    {{/each}}
  </div>

  <div class="form-group">
    <label>{{localize "ddb-importer.behaviors.display.FIELDS.color.label"}}</label>
    <div class="form-fields">
      <label class="checkbox"><input type="checkbox" name="useProfileColor" {{#if useProfileColor}}checked{{/if}} /> {{localize "ddb-importer.behaviors.display.config.profileColor"}}</label>
      {{#unless useProfileColor}}
      <color-picker name="color" value="{{colorValue}}"></color-picker>
      {{/unless}}
    </div>
    <p class="hint">{{localize "ddb-importer.behaviors.display.FIELDS.color.hint"}}</p>
  </div>
  {{/if}}

  <footer class="ddbi-display-region-actions">
    <button type="button" class="munch-button" data-action="saveDisplay"><i class="fas fa-save"></i> {{localize "ddb-importer.behaviors.display.config.save"}}</button>
    <button type="button" class="munch-button" data-action="clearDisplay"><i class="fas fa-eraser"></i> {{localize "ddb-importer.behaviors.display.config.useDefault"}}</button>
    <button type="button" class="munch-button" data-action="closeApp"><i class="fas fa-times"></i> {{localize "ddb-importer.behaviors.display.config.cancel"}}</button>
  </footer>
</section>
