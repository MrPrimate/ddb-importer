<section class="ddbi-display-region-config-body">
  <div class="ddbi-display-region-preview-row">
    <div class="ddbi-display-region-preview-frame large" data-tooltip="One grid square, enlarged">
      <div class="ddbi-display-region-preview" data-grid="{{previewGridLarge}}" style="{{previewStyleLarge}}"><span class="ddbi-display-region-fill"></span></div>
    </div>
    <div class="ddbi-display-region-preview-frame" data-tooltip="Several grid squares at a smaller scale">
      <div class="ddbi-display-region-preview" data-grid="{{previewGrid}}" style="{{previewStyle}}"><span class="ddbi-display-region-fill"></span></div>
    </div>
  </div>
  <p class="hint ddbi-display-region-summary-text">{{summary}}</p>

  <div class="form-group">
    <label>Profile</label>
    <div class="form-fields">
      <div class="ddbi-display-region-picker">
        <select name="profile">
          {{#each profileOptions}}
          <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
          {{/each}}
        </select>
        <button type="button" class="ddbi-display-region-picker-edit" data-tooltip="Edit region display profiles" aria-label="Edit region display profiles">
          <i class="fa-solid fa-gears" inert></i>
        </button>
      </div>
    </div>
    <p class="hint">How this region's display is drawn. Leave the overrides below blank to take the profile's values.</p>
  </div>

  {{#if hasProfile}}
  <div class="form-group">
    <label>{{localize "ddb-importer.behaviors.display.FIELDS.pattern.label"}}</label>
    <div class="form-fields">
      <select name="pattern">
        {{#each patternOptions}}
        <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
        {{/each}}
      </select>
    </div>
    <p class="hint">{{localize "ddb-importer.behaviors.display.FIELDS.pattern.hint"}}</p>
  </div>

  {{#if showDashed}}
  <div class="form-group">
    <label>{{localize "ddb-importer.behaviors.display.FIELDS.dashed.label"}}</label>
    <div class="form-fields">
      <select name="dashed">
        {{#each dashedOptions}}
        <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
        {{/each}}
      </select>
    </div>
    <p class="hint">{{localize "ddb-importer.behaviors.display.FIELDS.dashed.hint"}}</p>
  </div>
  {{/if}}

  {{#if showBorder}}
  <div class="form-group">
    <label>{{localize "ddb-importer.behaviors.display.FIELDS.border.label"}}</label>
    <div class="form-fields">
      <select name="border">
        {{#each borderOptions}}
        <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
        {{/each}}
      </select>
    </div>
    <p class="hint">{{localize "ddb-importer.behaviors.display.FIELDS.border.hint"}}</p>
  </div>
  {{/if}}

  {{#if showPerSquare}}
  <div class="form-group">
    <label>Per Square</label>
    <div class="form-fields">
      <input type="number" name="perSquare" value="{{perSquare}}" min="1" max="20" step="1" placeholder="{{perSquarePlaceholder}}" />
    </div>
    <p class="hint">How many lines or symbols fit across one grid square; entering a count sets the spacing override so they space evenly. Blank clears the override.</p>
  </div>
  {{/if}}

  <div class="ddbi-display-region-config-grid">
    {{#each numericFields}}
    <div class="form-group">
      <label>{{label}}</label>
      <div class="form-fields">
        <input type="number" name="{{key}}" value="{{value}}" placeholder="{{placeholder}}" min="{{limits.min}}" max="{{limits.max}}" step="{{limits.step}}" />
      </div>
      <p class="hint">{{hint}}</p>
    </div>
    {{/each}}
  </div>

  <div class="form-group">
    <label>{{localize "ddb-importer.behaviors.display.FIELDS.color.label"}}</label>
    <div class="form-fields">
      <label class="checkbox"><input type="checkbox" name="useProfileColor" {{#if useProfileColor}}checked{{/if}} /> Use the profile's colour</label>
      {{#unless useProfileColor}}
      <color-picker name="color" value="{{colorValue}}"></color-picker>
      {{/unless}}
    </div>
    <p class="hint">{{localize "ddb-importer.behaviors.display.FIELDS.color.hint"}}</p>
  </div>
  {{/if}}

  <footer class="ddbi-display-region-actions">
    <button type="button" class="munch-button" data-action="saveDisplay"><i class="fas fa-save"></i> Save</button>
    <button type="button" class="munch-button" data-action="clearDisplay"><i class="fas fa-eraser"></i> Use Foundry Default</button>
    <button type="button" class="munch-button" data-action="closeApp"><i class="fas fa-times"></i> Cancel</button>
  </footer>
</section>
