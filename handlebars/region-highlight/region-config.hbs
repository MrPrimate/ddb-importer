<section class="ddbi-highlight-config-body">
  <div class="ddbi-highlight-preview-row">
    <div class="ddbi-highlight-preview-frame large" data-tooltip="One grid square, enlarged">
      <div class="ddbi-highlight-preview" data-grid="{{previewGridLarge}}" style="{{previewStyleLarge}}"><span class="ddbi-highlight-fill"></span></div>
    </div>
    <div class="ddbi-highlight-preview-frame" data-tooltip="Several grid squares at a smaller scale">
      <div class="ddbi-highlight-preview" data-grid="{{previewGrid}}" style="{{previewStyle}}"><span class="ddbi-highlight-fill"></span></div>
    </div>
  </div>
  <p class="hint ddbi-highlight-summary-text">{{summary}}</p>

  <div class="form-group">
    <label>Profile</label>
    <div class="form-fields">
      <div class="ddbi-highlight-picker">
        <select name="profile">
          {{#each profileOptions}}
          <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
          {{/each}}
        </select>
        <button type="button" class="ddbi-highlight-picker-edit" data-tooltip="Edit region highlight profiles" aria-label="Edit region highlight profiles">
          <i class="fa-solid fa-gears" inert></i>
        </button>
      </div>
    </div>
    <p class="hint">How this region's highlight is drawn. Leave the overrides below blank to take the profile's values.</p>
  </div>

  {{#if hasProfile}}
  <div class="form-group">
    <label>Pattern</label>
    <div class="form-fields">
      <select name="pattern">
        {{#each patternOptions}}
        <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
        {{/each}}
      </select>
    </div>
  </div>

  <div class="form-group">
    <label>Lines</label>
    <div class="form-fields">
      <select name="dashed">
        {{#each dashedOptions}}
        <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
        {{/each}}
      </select>
    </div>
    <p class="hint">Dashes apply to the line patterns; the edge band is always continuous.</p>
  </div>

  <div class="form-group">
    <label>Border</label>
    <div class="form-fields">
      <select name="border">
        {{#each borderOptions}}
        <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
        {{/each}}
      </select>
    </div>
    <p class="hint">A band inside the edge on top of the fill; the Edge Band pattern always has one.</p>
  </div>

  <div class="ddbi-highlight-config-grid">
    {{#each numericFields}}
    <div class="form-group">
      <label>{{label}}</label>
      <div class="form-fields">
        <input type="number" name="{{key}}" value="{{value}}" placeholder="{{placeholder}}" min="{{limits.min}}" max="{{limits.max}}" step="{{limits.step}}" />
      </div>
      <p class="hint">{{hint}}</p>
    </div>
    {{/each}}
  </div>

  <div class="form-group">
    <label>Colour</label>
    <div class="form-fields">
      <label class="checkbox"><input type="checkbox" name="useProfileColor" {{#if useProfileColor}}checked{{/if}} /> Use the profile's colour</label>
      {{#unless useProfileColor}}
      <color-picker name="color" value="{{colorValue}}"></color-picker>
      {{/unless}}
    </div>
    <p class="hint">The profile's colour is the region's own unless the profile sets one.</p>
  </div>
  {{/if}}

  <footer class="ddbi-highlight-actions">
    <button type="button" class="munch-button" data-action="saveHighlight"><i class="fas fa-save"></i> Save</button>
    <button type="button" class="munch-button" data-action="clearHighlight"><i class="fas fa-eraser"></i> Use Foundry Default</button>
    <button type="button" class="munch-button" data-action="closeApp"><i class="fas fa-times"></i> Cancel</button>
  </footer>
</section>
