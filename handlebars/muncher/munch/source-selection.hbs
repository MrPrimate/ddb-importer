{{! The sources half of a munch button row: opens the Sources and Cache window (source selection
    plus proxy cache management), and previews the selection the import will actually run with on
    hover. Included from every munch tab. }}
<button data-action="openSourceBookBrowser" type="button" class="munch-button ddb-munch-sources-button"
    aria-label="Sources and cache: open the source selection and cache management window, or hover to preview the source selection">
  <i class="fas fa-book"></i> Sources and Cache
</button>
