{{! The sources half of a munch button row: opens the Source Selection window, and previews the
    selection the import will actually run with on hover. Included from every munch tab. }}
<button data-action="openSourceBookBrowser" type="button" class="munch-button ddb-munch-sources-button"
    aria-label="Source selection: open the source selection window, or hover to preview it">
  <i class="fas fa-book"></i> Source Selection
</button>
