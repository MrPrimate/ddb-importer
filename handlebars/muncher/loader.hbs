<div class="ddb-muncher-loader">
  <p class="munching-task-notes" id="munching-task-notes">{{message}}</p>
  <div class="munching-progress munching-progress-primary">
    <div class="munching-progress-bar" style="width: 0%"></div>
  </div>
  <p class="munching-task-monster ddb-muncher-loader-quip" id="munching-task-monster">{{quip}}</p>
  <footer class="form-footer">
    <button type="button" data-action="cancel"><i class="fas fa-times"></i> Cancel</button>
  </footer>
</div>
