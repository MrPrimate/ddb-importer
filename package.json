{
  "name": "ddb-importer",
  "version": "7.3.16",
  "author": "MrPrimate",
  "description": "Foundry VTT module for integrating D&D Beyond content.",
  "private": true,
  "scripts": {
    "lint": "npx eslint src/ tools/",
    "lint-fix": "npx eslint src/ tools/ --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "audit:enrichers": "vitest run tests/audit/classes.audit.test.ts tests/audit/feats.audit.test.ts tests/audit/species.audit.test.ts",
    "audit:review": "node tools/review-enricher-findings.mjs",
    "build": "npm run clear; npm run link; webpack",
    "dev": "npm run link && node esbuild.config.mjs --watch",
    "dev:build": "npm run clear && npm run link && node esbuild.config.mjs",
    "clear": "rm -rf dist/*",
    "dev:foundryLinks": "node ./tools/create-symlinks.mjs",
    "link": "cd src/parser/enrichers && node _linkBuilder.js",
    "dev:link": "node ./tools/foundry-dev-link.mjs",
    "data:config": "node --env-file-if-exists=.env ./tools/fetch-ddb-config.mjs",
    "data:config:dry": "node --env-file-if-exists=.env ./tools/fetch-ddb-config.mjs --dry-run"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.9.0",
    "@typescript-eslint/eslint-plugin": "^8.56.0",
    "@vitest/coverage-v8": "^4.1.10",
    "dnd5e": "github:adriangaro/dnd5e-types#5.0.x",
    "esbuild": "^0.27.3",
    "eslint": "^10.0.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^62.7.0",
    "fallow": "^2.61.0",
    "fvtt-types": "github:League-of-Foundry-Developers/foundry-vtt-types#main",
    "jsdom": "^29.1.1",
    "node-fetch": "^3.2.10",
    "prettier": "^3.8.1",
    "prettier-eslint": "^16.4.2",
    "prompts": "^2.4.2",
    "socket.io-client": "^4.7.5",
    "terser": "^5.10.0",
    "terser-webpack-plugin": "^5.3.0",
    "ts-loader": "^9.5.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.0",
    "vitest": "^4.1.2",
    "webpack": "^5.76.0",
    "webpack-cli": "^4.7.2"
  }
}
